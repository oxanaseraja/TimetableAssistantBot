# TimetableAssistantBot Environment Variables
# Copy this file to .env and fill in the values
# All values can be referenced in configuration.yaml using ${VAR_NAME} syntax

# Required: Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Required: Telegram Chat ID (group or channel ID, negative for groups)
# Get it by adding @userinfobot to your group
TELEGRAM_CHAT_ID=-1001234567890

# Optional: Paths to data files (relative to configuration.yaml location)
# DATA_CITIES_PATH=data/cities.json
# DATA_USERS_PATH=data/users.json

# Optional: Core settings
# CORE_DEFAULT_TIMEZONE=null
# CORE_MAX_TIME_MENTIONS=3

# Optional: Output settings
# OUTPUT_MAX_TIMEZONES=5
# OUTPUT_ORDERING=SOURCE_FIRST

# Optional: Telegram adapter settings
# TELEGRAM_MAX_LINES=5
# TELEGRAM_RETRY_ATTEMPTS=3
# TELEGRAM_PERSISTENCE_PATH=null

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
